+
+    @Test
+    void testAbbreviateThrowsWhenUpperBelowMinusOneEvenIfNotLessThanLower() {
+        assertThrows(IllegalArgumentException.class, () -> WordUtils.abbreviate(null, -5, -2, null));
+        assertThrows(IllegalArgumentException.class, () -> WordUtils.abbreviate("01 23 45", -5, -2, ""));
+    }
+
+    @Test
+    void initialsBufferSizeDoesNotOverflowForHugeInput() {
+        // strLen = 2^30: original buffer size = 2^29 + 1 (valid),
+        // mutated size strLen * 2 + 1 overflows to a negative value -> NegativeArraySizeException.
+        final int len = 1 << 30;
+        String huge;
+        try {
+            byte[] bytes = new byte[len];
+            Arrays.fill(bytes, (byte) 'a');
+            huge = new String(bytes, StandardCharsets.ISO_8859_1);
+            bytes = null;
+        } catch (final OutOfMemoryError e) {
+            return; // not enough heap to construct the input; cannot check
+        }
+        final String result;
+        try {
+            result = WordUtils.initials(huge);
+        } catch (final OutOfMemoryError e) {
+            return; // original buffer allocation needs ~2GB; tolerate a small heap
+        }
+        huge = null;
+        assertEquals("a", result);
+    }
+
+    @Test
+    void swapCaseUsesTitleCaseForLowerCaseAtWordStartAndUpperCaseInsideWord() {
+        // U+01C6 (lower dz-caron): title case is U+01C5, upper case is U+01C4
+        assertEquals("\u01C5", WordUtils.swapCase("\u01C6"));
+        assertEquals("A\u01C4", WordUtils.swapCase("a\u01C6"));
+        assertEquals("\u01C5\u01C4 \u01C5", WordUtils.swapCase("\u01C6\u01C6 \u01C6"));
+    }
+
+    @Test
+    void wrapLengthBelowOneIsTreatedAsOneAndOneIsKept() {
+        // Note: the "<" -> "<=" boundary mutant on the wrapLength clamp is equivalent:
+        // at wrapLength == 1 it assigns 1 to a value that is already 1.
+        // This test pins the boundary behaviour so any real regression is caught.
+        assertEquals("a\nb", WordUtils.wrap("a b", 1, "\n", false, " "));
+        assertEquals("a\nb", WordUtils.wrap("a b", 0, "\n", false, " "));
+        assertEquals("a\nb", WordUtils.wrap("a b", -5, "\n", false, " "));
+        assertEquals(WordUtils.wrap("ab cd ef", 1, "\n", true, " "),
+                WordUtils.wrap("ab cd ef", 0, "\n", true, " "));
+    }
